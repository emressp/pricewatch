# Copy to server/.env for local development. Never commit the real file.
# The process reads these from the environment. server/.env is loaded only if present,
# and it does not override variables that are already set.

NODE_ENV=development
PORT=8787
APP_BASE_URL=http://localhost:8787

# Required in production. Use a long random string.
SESSION_SECRET=replace-with-a-long-random-string

# Local SQLite file, used only when TURSO_DATABASE_URL is empty.
DATABASE_PATH=./data/pricewatch.sqlite

# Turso (hosted libSQL). Set both for the free Render service.
# A file: URL also works for local checks of this path, with no auth token.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Wakes the free Render service and runs one due-check pass: GET /cron/tick
# CRON_SECRET=replace-with-a-long-random-string

# Scheduler. Set CHECKER_ENABLED=0 if you run `npm run check` from cron instead.
CHECKER_ENABLED=1
CHECK_INTERVAL_SECONDS=60

# Polite fetching.
FETCH_MIN_INTERVAL_MS=2000
FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=1500000
USER_AGENT=PricewatchBot/1.0 (+https://emressp.github.io/pricewatch/monitor/; website change monitoring)

# Allow 127.0.0.1 and localhost so the local sample store works.
# Set to 0 in production. Private and link-local hosts are always refused.
ALLOW_LOCAL_FETCH=1

# Sample store and the "simulate a price change" buttons.
# Set to 0 in production.
DEMO_ENABLED=1

# Lets a signed-in user switch Watch / Seller / Research without Polar.
# Set to 0 in production. Plans then change only from the Polar webhook.
ALLOW_PLAN_SWITCH=1

# Behind Fly, Render, nginx, or Caddy, set this so Secure cookies work.
TRUST_PROXY=0

# Polar, same organization as the buy.polar.sh links already on the site.
# Product IDs are UUIDs from that org, not the public checkout-link ids.
# POLAR_SERVER is sandbox or production. Use production for the live org.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SELLER_PRODUCT_ID=
POLAR_RESEARCH_PRODUCT_ID=
POLAR_SERVER=production

# Email. Leave SMTP_HOST empty to use the console/outbox mailer.
# Gmail: port 587 is STARTTLS. MAIL_FROM must be the same address as SMTP_USER.
# SMTP_PASS is a Google app password, not the normal Gmail password.
# MAIL_DAILY_LIMIT skips further SMTP sends after this many messages per UTC day.
MAIL_FROM="Pricewatch <alerts@localhost>"
MAIL_DAILY_LIMIT=450
MAIL_OUTBOX=1
LOG_MAIL=1
OUTBOX_DIR=./data/outbox
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=you@gmail.com
# SMTP_PASS=
# MAIL_FROM=you@gmail.com
