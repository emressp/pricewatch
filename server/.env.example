# Copy to server/.env for local development. Never commit the real file.
# The process reads these from the environment. server/.env is loaded only if present,
# and it does not override variables that are already set.

NODE_ENV=development
PORT=8787
APP_BASE_URL=http://localhost:8787

# Required in production. Use a long random string.
SESSION_SECRET=replace-with-a-long-random-string

# SQLite file. On a host, point this at a persistent disk.
DATABASE_PATH=./data/pricewatch.sqlite

# Scheduler. Set CHECKER_ENABLED=0 if you run `npm run check` from cron instead.
CHECKER_ENABLED=1
CHECK_INTERVAL_SECONDS=60

# Polite fetching.
FETCH_MIN_INTERVAL_MS=2000
FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=1500000
USER_AGENT=PricewatchBot/1.0 (+https://emressp.github.io/pricewatch/monitor/; website change monitoring)

# Allow 127.0.0.1 and localhost so the local sample store works.
# Set to 0 in production. Private and link-local hosts are always refused.
ALLOW_LOCAL_FETCH=1

# Sample store and the "simulate a price change" buttons.
# Set to 0 in production.
DEMO_ENABLED=1

# Lets a signed-in user switch Watch / Seller / Research without billing.
# Set to 0 in production and change users.plan from your biller instead.
ALLOW_PLAN_SWITCH=1

# Behind Fly, Render, nginx, or Caddy, set this so Secure cookies work.
TRUST_PROXY=0

# Email. Leave SMTP_HOST empty to use the console/outbox mailer.
MAIL_FROM="Pricewatch <alerts@localhost>"
MAIL_OUTBOX=1
LOG_MAIL=1
OUTBOX_DIR=./data/outbox
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
